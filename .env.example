# Exemple uniquement : ne jamais placer de secrets ou de valeurs industrielles réelles ici.
# Les paramètres définitifs sont à confirmer avec l'encadrant.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Configuration PostgreSQL locale et fictive pour le développement.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=printing_service
DB_USERNAME=printing_service
DB_PASSWORD=printing_service_dev

# Worker PostgreSQL et scénarios des adapters fictifs.
PRINT_QUEUE_ENABLED=true
PRINT_QUEUE_POLL_DELAY_MS=2000
PRINT_QUEUE_RECOVERY_DELAY_MS=60000
PRINT_QUEUE_PROCESSING_TIMEOUT=PT2M
PRINT_QUEUE_BASE_RETRY_DELAY=PT10S
PRINT_QUEUE_BATCH_SIZE=5
FAKE_LABEL_MODE=SUCCESS
FAKE_DOCUMENT_MODE=SUCCESS
DEMO_DATA_ENABLED=true
